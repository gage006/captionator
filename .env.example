# Copy to .env to override defaults. `docker compose` reads this file and passes
# these through to the backend/worker/beat containers; any value left unset falls
# back to the default shown here, so the stack also runs with no .env present.

# Whisper model. English-only: tiny.en / base.en / small.en / medium.en.
# Multilingual: tiny / base / small / medium / large-v3. Larger = more accurate
# but slower and more RAM. base.en is the recommended starting point — tiny.en
# is fast but noticeably mis-hears words on real speech. The model is
# downloaded on first use and cached.
WHISPER_MODEL=base.en

# CTranslate2 compute type for transcription. int8_float32 is near-lossless and
# fast on CPU; use int8 for less RAM, or float32 to disable quantization.
WHISPER_COMPUTE_TYPE=int8_float32

# CPU threads for transcription; 0 auto-detects physical cores.
WHISPER_CPU_THREADS=0

# Seconds after a job completes before its upload/output files are deleted.
CLEANUP_DELAY_SECONDS=600

# Extra browser origins allowed via CORS (comma-separated). Empty by default —
# the app is same-origin behind nginx, so CORS is only needed when the API is
# called from a different origin. Example: https://captions.example.com
CORS_ORIGINS=

# Silence removal tuning (only applies when a user checks "Remove silences").
# Audio quieter than this (dBFS) counts as silence.
SILENCE_THRESHOLD_DB=-30.0
# Minimum seconds of quiet to count as removable silence.
SILENCE_MIN_DURATION=0.5
# Seconds of padding kept around each cut, to avoid clipping word onsets.
SILENCE_PADDING=0.15
# Safety cap on kept-segment count after silence removal.
SILENCE_MAX_SEGMENTS=60
